                <other-nos-connections>
                    <!-- <nos-connection>
                        <name>sc1</name>
                        <connection-string>tcp://10.10.10.101:12001</connection-string>
                    </nos-connection>
                    <nos-connection>
                        <name>sc2</name>
                        <connection-string>tcp://10.10.10.102:12001</connection-string>
                    </nos-connection> -->
